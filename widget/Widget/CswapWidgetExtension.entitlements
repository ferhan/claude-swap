<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The snapshot is written by the user's own `cswap` CLI, installed from
	     PyPI. A python3 process carries no code signature and so no
	     entitlement, which rules out an App Group container: containermanagerd
	     denies an unentitled writer. The contract is therefore an ordinary
	     absolute path, and this is the sandbox exception that lets a sandboxed
	     reader open it.

	     Scoped to the single file, not the directory: without the trailing
	     slash the sandbox grants exactly this path, so the sibling
	     credentials/, configs/ and settings.json in the same backup root stay
	     unreadable. Verified: with this entitlement the extension reads
	     snapshot.json and gets EPERM on settings.json next to it.

	     Must stay in lockstep with SnapshotFile.url. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
	<array>
		<string>/.claude-swap-backup/snapshot.json</string>
	</array>
</dict>
</plist>
