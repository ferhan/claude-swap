<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Plain sandbox, no exceptions: the host is a stub that never reads the
	     snapshot. Only the extension does, and only it carries the read
	     exception. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
