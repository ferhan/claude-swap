#!/bin/bash
# Stop a cswap service and remove its LaunchAgent.
#
#   ./stop-service             the backend auto-switch engine (default)
#   ./stop-service menubar     the menu bar UI
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SERVICE="${1:-auto}"
case "$SERVICE" in
    auto)    LABEL="com.cswap.auto" ;;
    menubar) LABEL="com.cswap.menubar" ;;
    *) echo "usage: $(basename "$0") [auto|menubar]" >&2; exit 2 ;;
esac

if [[ -x "$REPO/.venv/bin/cswap" ]]; then
    if [[ "$SERVICE" == "auto" ]]; then
        exec "$REPO/.venv/bin/cswap" service uninstall
    fi
    exec "$REPO/.venv/bin/cswap" menubar --uninstall-service
fi

# Dev venv is gone but the agent may still be loaded from a previous run.
launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
rm -f "$HOME/Library/LaunchAgents/$LABEL.plist"
echo "Removed $LABEL"
